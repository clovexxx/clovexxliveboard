    }
    entries[data.UID] = entry
    sourceToUid[sourceFrame] = data.UID
    setClaimed(entry, ownerUserId, ownerDisplayName)

    tradeBtn.MouseButton1Click:Connect(function()
        if not UNLOCKED then notify("Trade", "Locked - send one manual trade first", 3); return end
        if entry.ClaimedUserId and entry.ClaimedUserId ~= LocalPlayer.UserId then
            sendTradeToPlayer(entry.ClaimedUserId, entry.ClaimedName)
        else
            notify("Trade", "No valid owner", 1)
        end
    end)

    local count = 0
    for _ in pairs(entries) do count = count + 1 end
    if count > CONFIG.MaxRows then
        local oldestUid, oldestLayout
        for uid, e in pairs(entries) do
            if not oldestLayout or e.Frame.LayoutOrder > oldestLayout then
                oldestLayout = e.Frame.LayoutOrder; oldestUid = uid
            end
        end
        if oldestUid then destroyEntry(oldestUid) end
    end
    updateCount()
    if applyFilter then applyFilter() end
end

local function findLiveScrollers()
    local out = {}
    local function scan(root)
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("ScrollingFrame") then
                local hits = 0
                for _, t in ipairs(d:GetDescendants()) do
                    if t:IsA("TextLabel") then
                        local tx = lower(getLabelText(t))
                        if tx:find("spawned",1,true) or tx:find("[global]",1,true) or tx:find("[server]",1,true) then
                            hits = hits + 1; if hits >= 2 then break end
                        end
                    end
                end
                if hits >= 2 then table.insert(out, d) end
            end
        end
    end
    scan(workspace); scan(PlayerGui)
    return out
end

local function parseRowFrame(frame)
    if not frame.Visible then return nil end
    local labels = {}
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("TextLabel") then table.insert(labels, d) end
    end
    if #labels == 0 then return nil end
    local ownerName, isServer, spawnedText = "UNCLAIMED", false, ""
    local brainrotKey, mutationName = nil, nil
    for _, lbl in ipairs(labels) do
        local raw = getLabelText(lbl)
        if raw ~= "" then
            local lowRaw = lower(raw)
            if lowRaw:find("[server]",1,true) then isServer = true end
            if lowRaw:find("spawned",1,true) then spawnedText = raw end
            if ownerName == "UNCLAIMED" then
                if raw:sub(1,1) == "@" then ownerName = raw:sub(2)
                elseif lowRaw:match("^[a-z0-9_]+$") and #raw >= 3 and #raw <= 20 then ownerName = raw end
            end
            if not brainrotKey then local k = resolveAnimalKey(raw); if k then brainrotKey = k end end
            if not mutationName then
                for mutName, _ in pairs(Mutations) do
                    if lower(mutName) == lowRaw then mutationName = mutName; break end
                end
            end
        end
    end
    if spawnedText == "" or not brainrotKey then return nil end

    local ownerUserId
    if ownerName ~= "UNCLAIMED" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name == ownerName or p.DisplayName == ownerName then
                ownerUserId = p.UserId; break
            end
        end
        if not ownerUserId then
            local ok, uid = pcall(function() return Players:GetUserIdFromNameAsync(ownerName) end)
            if ok then ownerUserId = uid end
        end
    end

    return {
        SourceFrame = frame, BrainrotKey = brainrotKey, OwnerName = ownerName,
        OriginServer = isServer, MutationName = mutationName,
        OwnerUserId = ownerUserId, SpawnedText = spawnedText,
    }
end

local function upsertParsed(parsed)
    local uid = sourceToUid[parsed.SourceFrame]
    if uid and entries[uid] then
        local entry = entries[uid]
        if entry.ClaimedName ~= parsed.OwnerName then
            setClaimed(entry, parsed.OwnerUserId, parsed.OwnerName)
        end
        return
    end
    local newUid = "lb_" .. HttpService:GenerateGUID(false)
    createEntry({
        UID = newUid, BrainrotName = parsed.BrainrotKey,
        Mutation = parsed.MutationName, IsLocalServer = parsed.OriginServer,
        DisplayDuration = 0,
    }, parsed.OwnerUserId, parsed.OwnerName, parsed.SourceFrame)
end

local function cleanupMissing(stillSeen)
    local toRemove = {}
    for uid, e in pairs(entries) do
        if not stillSeen[e.SourceFrame] then table.insert(toRemove, uid) end
    end
    for _, uid in ipairs(toRemove) do destroyEntry(uid) end
end

task.spawn(function()
    while true do
        local seenSources, seenFingerprints = {}, {}
        for _, sc in ipairs(findLiveScrollers()) do
            for _, d in ipairs(sc:GetDescendants()) do
                if d:IsA("Frame") then
                    local parsed = parseRowFrame(d)
                    if parsed then
                        local fp = table.concat({
                            lower(parsed.BrainrotKey), lower(parsed.OwnerName),
                            parsed.OriginServer and "server" or "global",
                            lower(parsed.SpawnedText),
                        }, "|")
                        if not seenFingerprints[fp] then
                            seenFingerprints[fp] = true
                            seenSources[parsed.SourceFrame] = true
                            upsertParsed(parsed)
                        end
                    end
                end
            end
        end
        cleanupMissing(seenSources)
        updateCount()
        if applyFilter then applyFilter() end
        task.wait(CONFIG.PollInterval)
    end
end)

applyFilter = function()
    local q = lower(SearchBox.Text or "")
    local mode = MODES[modeIndex]
    for _, entry in pairs(entries) do
        local modeOk =
            (mode == "BOTH")
            or (mode == "CLAIMED" and entry.IsClaimed)
            or (mode == "UNCLAIMED" and not entry.IsClaimed)
        local key = lower(entry.Data.BrainrotName or "")
        local display = lower((Animals[entry.Data.BrainrotName] and Animals[entry.Data.BrainrotName].DisplayName) or "")
        local owner = lower(entry.ClaimedName or "")
        local mut = lower(entry.Data.Mutation or "")
        local textOk = q == "" or key:find(q,1,true) or display:find(q,1,true)
            or owner:find(q,1,true) or mut:find(q,1,true)
        entry.Frame.Visible = modeOk and textOk and true or false
    end
end
SearchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)

