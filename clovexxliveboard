        end)
    end
end

local INVITE_REMOTE = nil
local SESSION_TOKEN = nil
local UNLOCKED = false

local hookmeta = hookmetamethod or rawget(_G, "hookmetamethod")
local namecallMethod = getnamecallmethod or rawget(_G, "getnamecallmethod")

local NetFolder = ReplicatedStorage:FindFirstChild("Packages")
    and ReplicatedStorage.Packages:FindFirstChild("Net")

local OnUnlock = function() end

if hookmeta and namecallMethod and NetFolder then
    local old
    old = hookmeta(game, "__namecall", function(self, ...)
        if not UNLOCKED then
            local m
            local ok = pcall(function() m = namecallMethod() end)
            if ok and m == "InvokeServer" and typeof(self) == "Instance" and self.Parent == NetFolder then
                local args = {...}
                if #args == 2 and type(args[1]) == "string" and #args[1] == 36
                   and type(args[2]) == "number" then
                    INVITE_REMOTE = self
                    SESSION_TOKEN = args[1]
                    UNLOCKED = true
                    local capturedName = self.Name
                    local capturedToken = args[1]
                    task.defer(function()
                        print(("[Clovexx] Captured: %s | %s"):format(capturedName, capturedToken))
                        notify("CLOVEXX", "Remote captured - UI unlocked", 4)
                        OnUnlock()
                    end)
                end
            end
        end
        return old(self, ...)
    end)
end

local function sendTradeToPlayer(userId, username)
    if not UNLOCKED or not INVITE_REMOTE or not SESSION_TOKEN then
        notify("Trade", "Locked - send one manual trade first", 3)
        return false
    end
    local ok, success, err = pcall(function()
        return INVITE_REMOTE:InvokeServer(SESSION_TOKEN, userId)
    end)
    if not ok then notify("Trade Error", tostring(success), 3); return false end
    if success then notify("Trade Sent", "-> " .. username, 2); return true end
    notify("Trade Failed", tostring(err), 3); return false
end

