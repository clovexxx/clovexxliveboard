        StarterGui:SetCore("SendNotification", {
            Title = title or "CLOVEXX", Text = text or "", Duration = duration or 4
        })
    end)
end

local function newInstance(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(parent, r)
    newInstance("UICorner", { CornerRadius = r or CONFIG.Corner }, parent)
end

local function stroke(parent, color, thickness)
    newInstance("UIStroke", {
        Color = color or CONFIG.CloverGreen3,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function makeAnimatedClover(parent, vertical)
    local g = newInstance("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Color3.fromRGB(60, 80, 65)),
            ColorSequenceKeypoint.new(0.3,  CONFIG.CloverGreen1),
            ColorSequenceKeypoint.new(0.55, Color3.fromRGB(200, 210, 200)),
            ColorSequenceKeypoint.new(0.8,  CONFIG.CloverGreen3),
            ColorSequenceKeypoint.new(1,    Color3.fromRGB(60, 80, 65)),
        }),
        Rotation = vertical and 90 or 0,
    }, parent)
    g.Offset = Vector2.new(-1, 0)
    TweenService:Create(g,
        TweenInfo.new(CONFIG.GradientCycle, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false),
        { Offset = Vector2.new(1, 0) }
    ):Play()
    return g
end

local function normalize(s) return (s or ""):gsub("%s+", " "):gsub("^%s+",""):gsub("%s+$","") end
local function lower(s) return string.lower(normalize(s)) end
local function getLabelText(lbl)
    local t = ""
    pcall(function() t = (lbl.ContentText ~= "" and lbl.ContentText) or lbl.Text or "" end)
    return normalize(t)
end

local function rarityTag(text, rarityName)
    local r = Rarities[rarityName]
    if not r then return text end
    if r.GradientPreset then
        local tag = string.lower(r.GradientPreset)
        return ("<%s>%s</%s>"):format(tag, text, tag)
    end
    if r.Color then
        return ('<font color="#%s">%s</font>'):format(r.Color:ToHex(), text)
    end
    return text
end

local function safeAttachViewport(viewport, brainrotName, mutation)
    if SharedAnimals and Animals[brainrotName] then
        pcall(function()
