local function destroyEntry(uid)
    local entry = entries[uid]
    if not entry then return end
    if entry.RichTextTrove and entry.RichTextTrove.Destroy then
        pcall(function() entry.RichTextTrove:Destroy() end)
    end
    sourceToUid[entry.SourceFrame] = nil
    local row = entry.Frame
    local out = TweenService:Create(row, TweenInfo.new(0.18), {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0)
    })
    out:Play()
    out.Completed:Connect(function() row:Destroy() end)
    entries[uid] = nil
    updateCount()
end

local function updateTradeButtonState(entry)
    local btn = entry.TradeBtn
    if entry.ClaimedUserId and entry.ClaimedUserId ~= LocalPlayer.UserId then
        btn.Text = "TRADE"
        btn.TextColor3 = CONFIG.TextColor
        btn.BackgroundColor3 = CONFIG.CloverGreen1
        btn.Active = true
        btn.AutoButtonColor = true
    else
        btn.Text = "N/A"
        btn.TextColor3 = CONFIG.MutedText
        btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        btn.Active = false
        btn.AutoButtonColor = false
    end
end

local function setClaimed(entry, userId, displayName)
    local wasUnclaimed = (entry.ClaimedName == "UNCLAIMED")
    entry.ClaimedUserId = userId
    entry.ClaimedName = displayName or "UNCLAIMED"
    entry.IsClaimed = (userId ~= nil and displayName ~= nil and displayName ~= "UNCLAIMED")

    if entry.IsClaimed then
        entry.PlayerLabel.Text = displayName
        entry.PlayerLabel.TextColor3 = CONFIG.TextColor
        entry.Headshot.Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100"):format(userId)
        entry.Headshot.Visible = true
    else
        entry.PlayerLabel.Text = "UNCLAIMED"
        entry.PlayerLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        entry.Headshot.Visible = false
    end
    updateTradeButtonState(entry)

    if wasUnclaimed and entry.IsClaimed then
        notify("Claimed", entry.ClaimedName .. " claimed " .. entry.Data.BrainrotName, 4)
        if autoTradeEnabled and UNLOCKED and entry.ClaimedUserId and entry.ClaimedUserId ~= LocalPlayer.UserId and not entry.AutoTradeSent then
            entry.AutoTradeSent = true
            task.spawn(function()
                task.wait(CONFIG.AutoTradeCooldownSeconds)
                entry.AutoTradeSent = false
            end)
            sendTradeToPlayer(entry.ClaimedUserId, entry.ClaimedName)
        end
    end

    if applyFilter then applyFilter() end
end

